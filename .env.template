# .env.template — copy to the relevant profile's .env and fill in your own values.
#
# Hermes keeps credentials ONLY in .env (never config.yaml). Each profile has its
# own .env at <HERMES_HOME>/.env for the default profile, or
# <HERMES_HOME>/profiles/<name>/.env for a specialist.
#
# Which keys go where is a design decision: give a profile only the credentials it
# actually needs. A profile that cannot reach a provider cannot silently spend on it.
#
# NEVER commit a filled-in .env. Distributions ship this template as .env.EXAMPLE.

# ── Model providers ──────────────────────────────────────────────────────────
# OpenRouter — the usual default for every profile that runs a hosted model.
OPENROUTER_API_KEY=

# Google — only for profiles that use Gemini or a Google image-gen backend.
# GOOGLE_API_KEY=

# OpenAI — only for profiles that use OpenAI models or an OpenAI image backend.
# OPENAI_API_KEY=

# ── Messaging gateway ────────────────────────────────────────────────────────
# Only the profile that runs the gateway bot needs these.
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_CHANNELS=[]
# DISCORD_ALLOWED_USERS=[]

# ── Self-hosted web search ───────────────────────────────────────────────────
# Point this at your SearXNG instance (JSON format must be enabled).
# SEARXNG_URL=http://localhost:8080

# ── Terminal sandbox selection ───────────────────────────────────────────────
# Set on profiles that run a non-default terminal backend (e.g. docker).
# TERMINAL_ENV=

# ── Pet generation (optional) ────────────────────────────────────────────────
# Pin the image backend used for /hatch so it cannot silently fall back.
# HERMES_PET_IMAGE_PROVIDER=
