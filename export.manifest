# export.manifest — what the public skeleton takes from the live harness, and how.
#
# class <TAB> repo_path <TAB> live_path   ($HERMES_HOME is expanded)
#
#   copy    verbatim; any difference is drift and export.sh --check fails
#   manual  derived by hand; the live SOURCE hash is tracked, so a change means
#           "re-port needed" rather than being silently ignored
#   own     authored here; never overwritten, never compared
#
# Anything not listed is assumed `own`. Listing an `own` file is documentation only.

# ── copy: mechanism, byte-for-byte ──────────────────────────────────────────
copy	scripts/brief.py	$HERMES_HOME/scripts/brief.py
copy	plugins/session-brief/__init__.py	$HERMES_HOME/plugins/session-brief/__init__.py
copy	plugins/session-brief/plugin.yaml	$HERMES_HOME/plugins/session-brief/plugin.yaml
copy	map/scripts/map_check.py	$HERMES_HOME/scripts/map_check.py
# Live board viewer + its concurrency regression test (reads board.md on every request).
copy	scripts/board_server.py	$HERMES_HOME/scripts/board_server.py
copy	scripts/board-race.py	$HERMES_HOME/scripts/board-race.py
# The desktop note surface. `copy` (not `own`) so the repo and the installed copy cannot drift:
# the installed home is $HERMES_HOME/surfaces/windows, so the live path is expressible.
# fetch-webview2.sh and README.md stay `own` -- the first is repo-only tooling, the second
# documents both surfaces in this directory.
copy	surfaces/windows/board-note.ps1	$HERMES_HOME/surfaces/windows/board-note.ps1
copy	surfaces/windows/run-board-note.cmd	$HERMES_HOME/surfaces/windows/run-board-note.cmd
copy	surfaces/windows/install-startup.ps1	$HERMES_HOME/surfaces/windows/install-startup.ps1
copy	surfaces/windows/wv2-selftest.ps1	$HERMES_HOME/surfaces/windows/wv2-selftest.ps1
copy	surfaces/windows/screenshot.ps1	$HERMES_HOME/surfaces/windows/screenshot.ps1
copy	surfaces/windows/test-launch.ps1	$HERMES_HOME/surfaces/windows/test-launch.ps1
copy	surfaces/windows/board-note.md	$HERMES_HOME/surfaces/windows/board-note.md

# ── manual: derived, needs judgement, cannot be regenerated safely ──────────
# SOULs are the live file with personal territory removed + a Personalize block.
manual	profiles/default/SOUL.md	$HERMES_HOME/SOUL.md
manual	profiles/coder/SOUL.md	$HERMES_HOME/profiles/coder/SOUL.md
manual	profiles/health-check-doctor/SOUL.md	$HERMES_HOME/profiles/health-check-doctor/SOUL.md
manual	profiles/playground-manager/SOUL.md	$HERMES_HOME/profiles/playground-manager/SOUL.md
manual	profiles/project-manager/SOUL.md	$HERMES_HOME/profiles/project-manager/SOUL.md
manual	profiles/reporting-agent/SOUL.md	$HERMES_HOME/profiles/reporting-agent/SOUL.md
manual	profiles/research-engineer/SOUL.md	$HERMES_HOME/profiles/research-engineer/SOUL.md
# The public checks file is a 9-claim template; the live one is 66 machine claims.
own	map/ecosystem-map.checks.yaml	-
# The public skill is a redacted copy; the live one carries private context.
manual	skills/hermes-ecosystem-ops/SKILL.md	$HERMES_HOME/skills/hermes-ecosystem-ops/SKILL.md

# ── own: authored in this repo ──────────────────────────────────────────────
own	README.md	-
own	SHIPPING.md	-
own	SANITIZE.md	-
own	bootstrap.sh	-
own	setup.sh	-
own	scripts/preflight.sh	-
own	start.cmd	-
own	scripts/handover.sh	-
own	export.sh	-
own	export.manifest	-
own	.sanitize-patterns	-
own	.env.template	-
own	.gitignore	-
own	map/ecosystem-map.template.md	-
own	registry/SCHEMA.md	-
own	registry/board.md	-
own	registry/projects.md	-
own	registry/inbox/README.md	-
own	docs/JOURNEY.md	-
own	cron/weekly-drift-check.sh	-
own	cron/weekly-drift-check.job.md	-
own	hooks/pre-commit	-

# The guide ships complete (no Personalize block): it is the thing that fills in everyone else's.
own	profiles/guide/SOUL.md	-
own	profiles/guide/distribution.yaml	-
own	profiles/guide/skills/onboarding-guide/SKILL.md	-
own	surfaces/windows/guide-bridge.py	-
own	surfaces/windows/guide-window.ps1	-
own	surfaces/windows/run-guide-window.cmd	-
own	surfaces/windows/README.md	-
own	surfaces/windows/fetch-webview2.sh	-
