# Credentials — NEVER commit these. The template (.env.template) is the shipped form.
.env
.env.EXAMPLE
*.env
!*.env.template

# Python build artifacts
__pycache__/
*.py[cod]

# Profile exports / backups
*.tar.gz
profile-exports/
backups/

# Private context that must never enter this repo
memories/
sessions/
workspace/
plans/
home/
cache/
local/
auth.json
pairing/
platforms/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# State and session data — one machine's runtime, never the skeleton
*.db
*.db-wal
*.db-shm
*.key
*.pem
.env.lock
auth.json
state/
# Live cron STATE only — the repo has a cron/ folder of specs and scripts that must ship.
cron/jobs.json
cron/jobs.json.bak*
cron/*.db
cron/*.db-*
cron/output/
cron/admissions/
desktop/
bot_relay/
logs/
*.log
.skills_prompt_snapshot.json

# The FILLED map is a statement about one machine; only the template ships.
